{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "services": {
    "web": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app:app",
      "buildCommand": "npm --prefix apps/web ci && npm --prefix apps/web run build && python scripts/prepare_static.py"
    }
  }
}
